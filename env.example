# TFOTB configuration. `make setup` copies this to .env (git-ignored). Never commit real keys.
# Everything works with all keys blank: LLM_MODE=replay serves saved responses and makes no network calls.

# --- API server (used today) ---
PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- LLM layer (src/atlas/llm) ---
# replay = saved responses only, no network (default, safe). record = live calls, saved for replay.
LLM_MODE=replay
# OpenAI is the only provider. The adapter (src/atlas/llm/openai_client.py) is tested offline only; no live call
# has been made from this repo. Set OPENAI_API_KEY and BOTH model names below (no default is assumed).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=

# --- Deployment only (not used yet) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# --- Literature fetch, later (optional; raises the PubMed rate limit from 3 to 10 requests/s) ---
NCBI_API_KEY=
NCBI_EMAIL=

# --- On-demand research (POST /api/research). OFF by default: a live run can spend money. ---
# RESEARCH_ENABLED=true turns the endpoint on. Set RESEARCH_TOKEN so only your client can use it; the
# client sends it as the X-Research-Token header. Caps come from config/ingest_policy.json.
# Reading papers needs the GO and ChEBI files (scripts/fetch_ontologies.py), which the deployed image
# does not include, so on the deployed API a job reports that plainly instead of running.
RESEARCH_ENABLED=false
RESEARCH_TOKEN=
RESEARCH_MAX_JOBS_PER_HOUR=6
